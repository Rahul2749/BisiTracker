# Android emulator default is http://10.0.2.2:5080; browser/iOS simulator default is http://localhost:5080.
# For a physical Android device, use your PC's LAN address and bind the development API to that address.
EXPO_PUBLIC_API_URL=http://localhost:5080
EXPO_PUBLIC_AUTH_MODE=development

# Production: use auth mode oidc, HTTPS API URL and a registered public/native client.
# EXPO_PUBLIC_AUTH_MODE=oidc
# EXPO_PUBLIC_OIDC_ISSUER=https://your-provider.example
# EXPO_PUBLIC_OIDC_CLIENT_ID=your-native-public-client-id
# EXPO_PUBLIC_OIDC_SCOPES=openid profile offline_access your-api-scope
# EXPO_PUBLIC_OIDC_AUDIENCE=your-api-audience
